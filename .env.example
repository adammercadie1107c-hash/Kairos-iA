# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (server-side only)
ANTHROPIC_API_KEY=your-anthropic-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (follow-up executor, called by n8n)
CRON_SECRET=your-cron-secret

# Instagram / Meta (server-side only)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
INSTAGRAM_VERIFY_TOKEN=your-webhook-verify-token
INSTAGRAM_REDIRECT_URI=https://kairos-i-a.vercel.app/api/auth/instagram/callback
